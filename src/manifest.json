{
  "package": "com.onecat.fitness.counter",
  "name": "健身计数助手",
  "versionName": "1.0.0",
  "versionCode": 1,
  "icon": "/assets/images/logo.png",
  "features": [
    {
      "name": "blueos.window.prompt"
    },
    {
      "name": "blueos.app.appmanager.router"
    },
    {
      "name": "blueos.hardware.sensor.sensor"
    },
    {
      "name": "blueos.hardware.vibrator.vibrator"
    },
    {
      "name": "blueos.storage.storage"
    }
  ],
  "deviceTypeList": [
    "watch",
    "watch-square"
  ],
  "config": {
    "designWidth": 466
  },
  "router": {
    "entry": "pages/ActionList",
    "pages": {
      "pages/ActionList": {
        "component": "index"
      },
      "pages/RepsSetting": {
        "component": "index"
      },
      "pages/TrainingReady": {
        "component": "index"
      },
      "pages/TrainingActive": {
        "component": "index"
      },
      "pages/SetComplete": {
        "component": "index"
      },
      "pages/TrainingHistory": {
        "component": "index"
      },
      "pages/TrainingDetail": {
        "component": "index"
      }
    }
  },
  "display": {
    "backgroundColor": "#ffffff"
  }
}
