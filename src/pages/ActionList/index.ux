<template>
  <div class="flex h-full flex-col bg-white">
    <!-- 顶部标题（简化） -->
    <div class="flex items-center justify-center py-6">
      <image class="h-10 w-10" src="/assets/icons/fitness.svg"></image>
      <text class="ml-2 text-2xl font-bold text-brand">健身计数</text>
    </div>

    <!-- 动作列表 -->
    <list class="flex-1" scrollbar="true">
      <list-item
        class="mx-6 my-2 flex items-center justify-between rounded-lg bg-gray-50 px-6 py-5"
        type="list-item"
        @click="onActionClick($item)"
        for="{{ actionList }}">
        <text class="text-3xl font-bold text-gray-800">{{ $item.actionName }}</text>
        <image class="h-6 w-6" src="/assets/icons/chevron-right.svg"></image>
      </list-item>
    </list>

    <!-- 底部历史按钮 -->
    <div class="flex items-center justify-center py-6">
      <div class="flex flex-col items-center" @click="onHistoryClick">
        <image class="h-10 w-10" src="/assets/icons/chart.svg"></image>
        <text class="mt-1 text-lg text-gray-500">历史</text>
      </div>
    </div>
  </div>
</template>

<script>
  import { ACTION_LIST } from '../../helper/actionConfig.js'

  export default {
    data: {
      actionList: ACTION_LIST,
    },

    onInit() {
      console.log('动作列表页初始化', this.actionList.length)
    },

    onActionClick(action) {
      console.log('选择动作:', action.actionName)
      global.router.push({
        uri: '/pages/RepsSetting',
        params: {
          actionCode: action.actionCode,
          actionName: action.actionName,
        },
      })
    },

    onHistoryClick() {
      global.router.push({
        uri: '/pages/TrainingHistory',
      })
    },
  }
</script>

<style>
  @tailwind utilities;
</style>
