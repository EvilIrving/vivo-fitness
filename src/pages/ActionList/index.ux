<template>
  <div class="flex h-full flex-col bg-gray-50">
    <!-- 标题栏 -->
    <div class="flex items-center justify-center bg-white py-6 shadow-sm">
      <text class="text-4xl font-bold text-brand">健身计数助手</text>
    </div>

    <!-- 动作列表 -->
    <list class="flex-1" scrollbar="true">
      <list-item
        class="mx-4 my-2 flex flex-col rounded-lg bg-white p-4 shadow-sm"
        type="list-item"
        @click="onActionClick($item)"
        for="{{ actionList }}">
        <div class="flex items-center">
          <!-- <image class="h-16 w-16 rounded-full" src="{{$item.icon}}"></image> -->
          <div class="ml-4 flex-1">
            <text class="text-3xl font-bold text-gray-800">{{ $item.actionName }}</text>
            <text class="mt-1 text-2xl text-gray-500">{{ $item.category }}</text>
            <text class="mt-1 text-xl text-gray-400">{{ $item.description }}</text>
          </div>
          <text class="text-3xl text-gray-300">›</text>
        </div>
      </list-item>
    </list>

    <!-- 底部导航 -->
    <div class="flex items-center justify-around border-t border-gray-200 bg-white py-4">
      <div class="flex flex-col items-center" @click="onHomeClick">
        <text class="text-3xl">🏋️</text>
        <text class="mt-1 text-xl text-brand">训练</text>
      </div>
      <div class="flex flex-col items-center" @click="onHistoryClick">
        <text class="text-3xl">📊</text>
        <text class="mt-1 text-xl text-gray-500">历史</text>
      </div>
    </div>
  </div>
</template>

<script>
  import { ACTION_LIST } from '../../helper/actionConfig.js'

  export default {
    data: {
      actionList: ACTION_LIST,
    },

    onInit() {
      console.log('动作列表页初始化', this.actionList.length)
    },

    onActionClick(action) {
      console.log('选择动作:', action.actionName)
      global.router.push({
        uri: '/pages/RepsSetting',
        params: {
          actionCode: action.actionCode,
          actionName: action.actionName,
        },
      })
    },

    onHistoryClick() {
      global.router.push({
        uri: '/pages/TrainingHistory',
      })
    },

    onHomeClick() {
      // 已在首页
    },
  }
</script>

<style>
  @tailwind utilities;
</style>
