<template>
  <div class="flex h-full flex-col items-center justify-between bg-white py-12">
    <!-- 顶部：动作名+组数 一行显示 -->
    <div class="flex w-full items-center justify-center">
      <text class="text-2xl text-gray-600">{{ actionName }}</text>
      <text class="ml-2 text-2xl text-gray-400">第 {{ currentSet }} 组</text>
    </div>
    
    <!-- 中心：超大计数 + 圆点进度 -->
    <div class="flex flex-col items-center">
      <text class="font-bold  text-4xl" style="color: {{ countColor }}">{{ currentCount }}</text>
      <text class="mt-1 text-xl text-gray-300">━━━</text>
      <text class="mt-1 text-3xl text-gray-400">{{ targetReps }}</text>
      
      <!-- 圆点进度指示器 -->
      <div class="mt-8 flex items-center justify-center space-x-1.5">
        <div class="h-2.5 w-2.5 rounded-full" style="background-color: {{ $item ? '#3B82F6' : 'transparent' }}; border: {{ $item ? 'none' : '1px solid #D1D5DB' }}" for="{{ progressDots }}"></div>
      </div>
    </div>
    
    <!-- 底部操作按钮 -->
    <div class="flex w-full items-center justify-center" if="{{ isTraining }}">
      <!-- 训练中：只显示暂停按钮 -->
      <div class="flex h-20 w-20 items-center justify-center rounded-full bg-gray-300" @click="pauseTraining">
        <image class="h-10 w-10" src="/assets/icons/pause.svg"></image>
      </div>
    </div>
    
    <div class="flex w-full items-center  justify-center" if="{{ !isTraining }}">
      <!-- 已暂停：显示继续+结束按钮 -->
      <div class="flex items-center justify-center">
        <div class="flex h-20 w-20 items-center justify-center rounded-full bg-brand" @click="resumeTraining">
          <image class="h-10 w-10" src="/assets/icons/play.svg"></image>
        </div>
        <div class="flex h-20 w-20 items-center justify-center rounded-full bg-gray-300" style="margin-left: 24px" @click="stopTraining">
          <image class="h-10 w-10" src="/assets/icons/stop.svg"></image>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  import sensorService from '../../helper/sensorService.js'
  import recognitionAlgorithm from '../../helper/recognitionAlgorithm.js'
  import { saveCurrentSession } from '../../helper/storageService.js'
  import { DELAY_MS } from '../../helper/constants.js'

  export default {
    data: {
      actionCode: '',
      actionName: '',
      targetReps: 12,
      currentCount: 0,
      currentSet: 1,
      isTraining: true,
      statusText: '准备中...',
      countColor: '#3B82F6',
      progress: 0,
      progressDots: [],
      startTime: 0,
    },

    onInit() {
      this.actionCode = this.actionCode || ''
      this.actionName = this.actionName || '训练'
      this.targetReps = parseInt(this.targetReps) || 12
      this.startTime = Date.now()
      
      // 初始化圆点进度数组
      this._initProgressDots()
      
      console.log('训练页面初始化:', {
        actionCode: this.actionCode,
        actionName: this.actionName,
        targetReps: this.targetReps,
      })
      
      // 延迟启动训练(给用户准备时间)
      setTimeout(() => {
        this._startSensorMonitoring()
      }, DELAY_MS.SENSOR_START)
    },

    _initProgressDots() {
      // 计算圆点数量（最多15个）
      const maxDots = 15
      const dotCount = Math.min(this.targetReps, maxDots)
      this.progressDots = new Array(dotCount).fill(false)
    },

    _updateProgressDots() {
      // 更新圆点显示状态
      const maxDots = 15
      const dotCount = Math.min(this.targetReps, maxDots)
      
      // 目标次数 ≤ 15：圆点与次数一一对应
      // 目标次数 > 15：按比例填充圆点
      if (this.targetReps <= maxDots) {
        // 一一对应模式
        this.progressDots = new Array(dotCount).fill(false).map((_, index) => index < this.currentCount)
      } else {
        // 比例模式
        const filledDots = Math.floor(this.currentCount / this.targetReps * maxDots)
        this.progressDots = new Array(maxDots).fill(false).map((_, index) => index < filledDots)
      }
    },

    onDestroy() {
      // 页面销毁时停止传感器
      sensorService.stop()
      console.log('训练页面销毁,传感器已停止')
    },

    _startSensorMonitoring() {
      // 初始化识别算法
      const success = recognitionAlgorithm.init(this.actionCode, (data) => {
        this._onActionDetected(data)
      })
      
      if (!success) {
        console.error('识别器初始化失败')
        return
      }
      
      // 启动传感器监听
      sensorService.start(
        (fusedData) => {
          // 将数据传给识别算法
          recognitionAlgorithm.process(fusedData)
        },
        (error) => {
          console.error('传感器错误:', error)
          this.isTraining = false
          this.countColor = '#EF4444'
        }
      )
      
      this.isTraining = true
      this.countColor = '#3B82F6'
    },

    _onActionDetected(data) {
      console.log('检测到动作完成!', data)
      
      // 计数+1
      this.currentCount++
      
      // 更新进度
      this.progress = Math.min((this.currentCount / this.targetReps) * 100, 100)
      
      // 更新圆点进度
      this._updateProgressDots()
      
      // 更新颜色（训练中保持蓝色）
      if (this.isTraining) {
        this.countColor = '#3B82F6'
      }
      
      // 震动反馈
      global.vibrator.vibrate({ mode: 'short' })
      
      // 检查是否完成目标
      if (this.currentCount >= this.targetReps) {
        this._onSetComplete()
      }
    },

    _onSetComplete() {
      console.log('组完成!')
      
      this.countColor = '#10B981' // 绿色
      this.isTraining = false
      
      // 长震动反馈
      global.vibrator.vibrate({ mode: 'long' })
      
      // 停止传感器
      sensorService.stop()
      
      // 保存当前会话数据
      const sessionData = {
        actionCode: this.actionCode,
        actionName: this.actionName,
        currentSet: this.currentSet,
        targetReps: this.targetReps,
        actualReps: this.currentCount,
        startTime: this.startTime,
        endTime: Date.now(),
      }
      
      saveCurrentSession(sessionData)
      
      // 延迟跳转到完成页面
      setTimeout(() => {
        global.router.replace({
          uri: '/pages/SetComplete',
          params: {
            actionCode: this.actionCode,
            actionName: this.actionName,
            actualReps: String(this.currentCount),
            targetReps: String(this.targetReps),
            currentSet: String(this.currentSet),
          },
        })
      }, DELAY_MS.SET_COMPLETE)
    },

    pauseTraining() {
      sensorService.pause()
      recognitionAlgorithm.pause()
      this.isTraining = false
      this.countColor = '#F59E0B' // 暂停状态显示橙色
      global.vibrator.vibrate({ mode: 'short' })
    },

    resumeTraining() {
      sensorService.resume()
      recognitionAlgorithm.resume()
      this.isTraining = true
      this.countColor = '#3B82F6' // 恢复训练显示蓝色
      global.vibrator.vibrate({ mode: 'short' })
    },

    stopTraining() {
      sensorService.stop()
      this.isTraining = false
      
      global.prompt.showToast({ message: '训练已结束' })
      
      setTimeout(() => {
        global.router.back()
      }, DELAY_MS.PAGE_TRANSITION)
    },
  }
</script>

<style>
  @tailwind utilities;
</style>
