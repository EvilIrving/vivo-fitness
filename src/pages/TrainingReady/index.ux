<template>
  <div class="flex h-full flex-col items-center justify-between bg-white py-12">
    <!-- 准备阶段：简洁信息展示 -->
    <div class="flex h-full flex-col items-center justify-between" if="{{ countdown === 0 }}">
      <div class="flex w-full justify-center">
        <text class="text-3xl" style="color: #6b7280">{{actionName}}</text>
      </div>
      
      <div class="flex flex-col items-center">
        <text class="text-5xl font-bold" style="color: #405eff">{{targetReps}}</text>
        <text class="mt-4 text-lg" style= "color: #9ca3af">次</text>
      </div>
      
      <!-- 开始按钮 -->
      <div class="flex h-20 w-20 items-center justify-center rounded-full bg-brand" @click="startCountdown">
        <image class="h-10 w-10" src="/assets/icons/play.svg"></image>
      </div>
    </div>
    
    <!-- 倒计时：极简数字 -->
    <div class="flex h-full flex-col items-center justify-center" if="{{ countdown > 0 }}">
      <text class="text-6xl font-bold" style="color: #405eff">{{countdown}}</text>
    </div>
  </div>
</template>

<script>
  export default {
    data: {
      actionCode: '',
      actionName: '',
      targetReps: 12,
      countdown: 0,
      timerId: null,
    },

    onInit() {
      this.actionCode = this.actionCode || ''
      this.actionName = this.actionName || '训练'
      this.targetReps = parseInt(this.targetReps) || 12
      
      console.log('训练准备页初始化:', {
        actionName: this.actionName,
        targetReps: this.targetReps,
      })
    },

    onDestroy() {
      // 清除定时器
      if (this.timerId) {
        clearInterval(this.timerId)
        this.timerId = null
      }
    },

    startCountdown() {
      // 震动反馈
      global.vibrator.vibrate({ mode: 'short' })
      
      // 开始3秒倒计时
      this.countdown = 3
      
      this.timerId = setInterval(() => {
        this.countdown--
        
        if (this.countdown > 0) {
          // 每秒震动提示
          global.vibrator.vibrate({ mode: 'short' })
        } else {
          // 倒计时结束,跳转到训练页面
          clearInterval(this.timerId)
          this.timerId = null
          
          // 长震动表示开始
          global.vibrator.vibrate({ mode: 'long' })
          
          setTimeout(() => {
            global.router.replace({
              uri: '/pages/TrainingActive',
              params: {
                actionCode: this.actionCode,
                actionName: this.actionName,
                targetReps: String(this.targetReps),
              },
            })
          }, 300)
        }
      }, 1000)
    },
  }
</script>

<style>
  @tailwind utilities;
</style>
