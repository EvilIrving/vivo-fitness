<template>
  <div class="flex h-full flex-col items-center justify-around bg-white">
    <!-- 顶部：动作名 -->
    <div class="flex w-full justify-center">
      <text class="text-4xl" style="color: #6b7280">{{ actionName }}</text>
    </div>
    
    <!-- 中心：简洁大数字 -->
    <div class="flex flex-col items-center">
      <text class="text-5xl font-bold" style="color: #1f2937">{{ targetReps }}</text>
      <text class="mt-4 text-2xl" style="color: #6b7280">目标次数</text>
    </div>
    
    <!-- 底部：精简按钮组 -->
    <div class="flex w-full items-center justify-center">
      <!-- 减少按钮 -->
      <div class="mx-2 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100" @click="decrease">
        <image class="h-8 w-8" src="/assets/icons/minus.svg"></image>
      </div>
      
      <!-- 确认按钮 -->
      <div class="mx-2 flex h-20 w-20 items-center justify-center rounded-full bg-brand" @click="startTraining">
        <image class="h-10 w-10" src="/assets/icons/check.svg"></image>
      </div>
      
      <!-- 增加按钮 -->
      <div class="mx-2 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100" @click="increase">
        <image class="h-8 w-8" src="/assets/icons/plus.svg"></image>
      </div>
    </div>
  </div>
</template>

<script>
  import { CONFIG } from '../../helper/constants.js'

  export default {
    data: {
      actionCode: '',
      actionName: '',
      targetReps: CONFIG.DEFAULT_TARGET_REPS,
    },

    onInit() {
      this.actionCode = this.actionCode || ''
      this.actionName = this.actionName || '未知动作'
      console.log('次数设定页初始化:', this.actionName)
    },

    increase() {
      if (this.targetReps < 50) {
        this.targetReps++
      }
    },

    decrease() {
      if (this.targetReps > 1) {
        this.targetReps--
      }
    },

    startTraining() {
      console.log('开始训练:', this.actionName, this.targetReps)
      
      // 震动反馈
      global.vibrator.vibrate({ mode: 'short' })
      
      global.router.push({
        uri: '/pages/TrainingReady',
        params: {
          actionCode: this.actionCode,
          actionName: this.actionName,
          targetReps: String(this.targetReps),
        },
      })
    },
  }
</script>

<style>
  @tailwind utilities;
</style>
