<template>
  <div class="flex h-full flex-col bg-gray-50">
    <!-- 顶部标题栏 -->
    <div class="flex items-center justify-between bg-white px-5 py-5 shadow-sm">
      <div class="flex h-10 w-10 items-center justify-center" @click="goBack">
        <image class="h-6 w-6" src="/assets/icons/chevron-left.svg"></image>
      </div>
      <text class="text-2xl font-bold text-gray-800">训练历史</text>
      <div class="w-10"></div>
    </div>

    <!-- 加载状态 -->
    <div class="flex flex-1 items-center justify-center" if="{{ loading }}">
      <text class="text-xl text-gray-400">加载中...</text>
    </div>

    <!-- 内容区域 -->
    <div class="flex flex-1 flex-col" if="{{ !loading }}">
      <!-- 统计数据卡片 -->
      <div class="mx-4 mt-4 rounded-xl bg-white p-5 shadow-sm">
        <div class="flex justify-around">
          <div class="flex flex-col items-center">
            <text class="text-4xl font-bold text-brand">{{ stats.totalWorkouts }}</text>
            <text class="mt-2 text-base text-gray-500">训练次数</text>
          </div>
          <div class="h-14 w-px bg-gray-200"></div>
          <div class="flex flex-col items-center">
            <text class="text-4xl font-bold text-brand">{{ stats.totalReps }}</text>
            <text class="mt-2 text-base text-gray-500">总计数</text>
          </div>
        </div>
      </div>

      <!-- 记录列表 -->
      <div class="mt-4 flex-1">
        <!-- 空状态 -->
        <div class="flex flex-col items-center justify-center pt-20" if="{{ records.length === 0 }}">
          <text class="text-6xl">📊</text>
          <text class="mt-4 text-xl text-gray-400">暂无训练记录</text>
          <text class="mt-2 text-base text-gray-300">完成训练后会在这里显示</text>
        </div>
        
        <!-- 记录列表 -->
        <div class="flex flex-col" if="{{ records.length > 0 }}">
          <text class="px-5 pb-2 text-base text-gray-500">最近训练</text>
          <list class="flex-1" scrollbar="true">
            <list-item
              class="mx-4 mb-3 overflow-hidden rounded-xl bg-white shadow-sm"
              type="list-item"
              @click="onRecordClick($item)"
              @longpress="onRecordLongPress($item)"
              for="{{ records }}">
              <div class="flex items-center justify-between px-5 py-4">
                <div class="flex flex-1 flex-col">
                  <text class="text-xl font-bold text-gray-800">{{ $item.actionName }}</text>
                  <div class="mt-2 flex items-center">
                    <text class="text-sm text-gray-400">{{ $item.date }}</text>
                    <text class="mx-2 text-sm text-gray-300">·</text>
                    <text class="text-sm text-gray-400">{{ $item.sets.length }} 组</text>
                  </div>
                </div>
                <div class="flex flex-col items-end">
                  <text class="text-3xl font-bold text-brand">{{ $item.totalReps }}</text>
                  <text class="mt-1 text-xs text-gray-400">次</text>
                </div>
              </div>
            </list-item>
          </list>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  import { getAllRecords, getUserStats, deleteRecord } from '../../helper/storageService.js'

  export default {
    data: {
      records: [],
      stats: {
        totalWorkouts: 0,
        totalReps: 0,
        totalDuration: 0,
      },
      loading: true,
    },

    async onInit() {
      console.log('历史记录页初始化')
      await this.loadData()
    },

    async onShow() {
      await this.loadData()
    },

    async loadData() {
      this.loading = true
      try {
        this.records = await getAllRecords()
        this.stats = await getUserStats()
        this.records.sort((a, b) => b.timestamp - a.timestamp)
        console.log('加载完成:', this.records.length)
      } catch (e) {
        console.error('加载数据失败:', e)
      } finally {
        this.loading = false
      }
    },

    onRecordClick(record) {
      global.router.push({
        uri: '/pages/TrainingDetail',
        params: {
          recordId: record.recordId,
        },
      })
    },

    onRecordLongPress(record) {
      global.prompt.showDialog({
        title: '删除记录',
        message: `确定要删除这条训练记录吗？\n${record.actionName} - ${record.date}`,
        buttons: [
          {
            text: '取消',
            color: '#888888',
          },
          {
            text: '删除',
            color: '#ff0000',
          },
        ],
        success: async (data) => {
          if (data.index === 1) {
            const success = await deleteRecord(record.recordId)
            if (success) {
              global.prompt.showToast({
                message: '删除成功',
              })
              await this.loadData()
            } else {
              global.prompt.showToast({
                message: '删除失败',
              })
            }
          }
        },
      })
    },

    goBack() {
      global.router.back()
    },
  }
</script>

<style>
  @tailwind utilities;
</style>
