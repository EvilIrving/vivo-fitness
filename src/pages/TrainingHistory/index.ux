<template>
  <div class="flex h-full flex-col bg-gray-50">
    <!-- 标题栏 -->
    <div class="flex items-center justify-between bg-white px-4 py-6 shadow-sm">
      <div class="flex h-12 w-12 items-center justify-center" @click="goBack">
        <text class="text-3xl text-gray-600">‹</text>
      </div>
      <text class="text-3xl font-bold text-gray-800">训练历史</text>
      <div class="w-12"></div>
    </div>

    <!-- 统计卡片 -->
    <div class="mx-4 mt-4 rounded-lg bg-white p-4 shadow-sm">
      <text class="text-2xl font-bold text-gray-800">总览</text>
      <div class="mt-3 flex justify-around">
        <div class="flex flex-col items-center">
          <text class="text-3xl font-bold text-brand">{{ stats.totalWorkouts }}</text>
          <text class="mt-1 text-xl text-gray-500">训练次数</text>
        </div>
        <div class="flex flex-col items-center">
          <text class="text-3xl font-bold text-brand">{{ stats.totalReps }}</text>
          <text class="mt-1 text-xl text-gray-500">总次数</text>
        </div>
      </div>
    </div>

    <!-- 记录列表 -->
    <div class="mt-4 flex-1">
      <text class="px-4 text-xl text-gray-500" if="{{ records.length === 0 }}">暂无训练记录</text>
      
      <list class="flex-1" scrollbar="true" if="{{ records.length > 0 }}">
        <list-item
          class="mx-4 my-2 flex flex-col rounded-lg bg-white p-4 shadow-sm"
          type="list-item"
          @click="onRecordClick($item)"
          for="{{ records }}">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <text class="text-2xl font-bold text-gray-800">{{ $item.actionName }}</text>
              <text class="mt-1 text-xl text-gray-500">{{ $item.date }}</text>
            </div>
            <div class="flex flex-col items-end">
              <text class="text-3xl font-bold text-brand">{{ $item.totalReps }}</text>
              <text class="text-lg text-gray-400">次</text>
            </div>
          </div>
        </list-item>
      </list>
    </div>

    <!-- 底部导航 -->
    <div class="flex items-center justify-around border-t border-gray-200 bg-white py-4">
      <div class="flex flex-col items-center" @click="onHomeClick">
        <text class="text-3xl">🏋️</text>
        <text class="mt-1 text-xl text-gray-500">训练</text>
      </div>
      <div class="flex flex-col items-center">
        <text class="text-3xl">📊</text>
        <text class="mt-1 text-xl text-brand">历史</text>
      </div>
    </div>
  </div>
</template>

<script>
  import { getAllRecords, getUserStats } from '../../helper/storageService.js'

  export default {
    data: {
      records: [],
      stats: {
        totalWorkouts: 0,
        totalReps: 0,
        totalDuration: 0,
      },
    },

    async onInit() {
      console.log('历史记录页初始化')
      await this.loadData()
    },

    async onShow() {
      await this.loadData()
    },

    async loadData() {
      this.records = await getAllRecords()
      this.stats = await getUserStats()
      this.records.sort((a, b) => b.timestamp - a.timestamp)
      console.log('加载完成:', this.records.length)
    },

    onRecordClick(record) {
      global.router.push({
        uri: '/pages/TrainingDetail',
        params: {
          recordId: record.recordId,
        },
      })
    },

    onHomeClick() {
      global.router.back()
    },

    goBack() {
      global.router.back()
    },
  }
</script>

<style>
  @tailwind utilities;
</style>
