<template>
  <div class="flex h-full flex-col items-center justify-center bg-white">
    <!-- 完成标志 -->
    <div class="absolute top-12 flex flex-col items-center">
      <image class="h-16 w-16" src="/assets/icons/check.svg"></image>
      <text class="mt-4 text-2xl text-gray-600">{{ actionName }}</text>
      <text class="mt-1 text-xl text-gray-400">第 {{ currentSet }} 组</text>
    </div>
    
    <!-- 中心：完成数据 -->
    <div class="flex flex-col items-center">
      <text class="text-8xl font-bold leading-none text-green-600">{{ actualReps }}</text>
      <text class="mt-2 text-xl text-gray-300">━━</text>
      <text class="mt-2 text-3xl text-gray-400">{{ targetReps }}</text>
    </div>
    
    <!-- 底部按钮 -->
    <div class="absolute bottom-10 flex items-center space-x-12">
      <!-- 继续下一组 -->
      <div class="flex flex-col items-center" @click="continueNextSet">
        <div class="flex h-20 w-20 items-center justify-center rounded-full border-2 border-brand">
          <image class="h-10 w-10" src="/assets/icons/refresh.svg"></image>
        </div>
        <text class="mt-2 text-lg text-gray-600">继续</text>
      </div>
      
      <!-- 结束训练 -->
      <div class="flex flex-col items-center" @click="finishTraining">
        <div class="flex h-20 w-20 items-center justify-center rounded-full border-2 border-gray-400">
          <image class="h-10 w-10" src="/assets/icons/check.svg"></image>
        </div>
        <text class="mt-2 text-lg text-gray-600">结束</text>
      </div>
    </div>
  </div>
</template>

<script>
  import { saveRecord, clearCurrentSession } from '../../helper/storageService.js'
  import { DELAY_MS } from '../../helper/constants.js'

  export default {
    data: {
      actionCode: '',
      actionName: '',
      actualReps: 0,
      targetReps: 12,
      currentSet: 1,
    },

    onInit() {
      this.actionCode = this.actionCode || ''
      this.actionName = this.actionName || '训练'
      this.actualReps = parseInt(this.actualReps) || 0
      this.targetReps = parseInt(this.targetReps) || 12
      this.currentSet = parseInt(this.currentSet) || 1
      
      console.log('组完成页初始化:', {
        actionName: this.actionName,
        actualReps: this.actualReps,
        targetReps: this.targetReps,
        currentSet: this.currentSet,
      })
    },

    continueNextSet() {
      console.log('继续下一组')
      
      // 震动反馈
      global.vibrator.vibrate({ mode: 'short' })
      
      // 返回到训练页面,开始下一组
      global.router.replace({
        uri: '/pages/TrainingActive',
        params: {
          actionCode: this.actionCode,
          actionName: this.actionName,
          targetReps: String(this.targetReps),
          currentSet: String(this.currentSet + 1),
        },
      })
    },

    async finishTraining() {
      console.log('结束训练,保存记录')
      
      // 构建训练记录
      const record = {
        actionCode: this.actionCode,
        actionName: this.actionName,
        sets: [
          {
            setNumber: this.currentSet,
            targetReps: this.targetReps,
            actualReps: this.actualReps,
            startTime: Date.now() - 60000, // 简化处理
            endTime: Date.now(),
            setDuration: 60, // 简化处理
          },
        ],
        totalReps: this.actualReps,
        duration: 60,
      }
      
      // 保存记录
      const success = await saveRecord(record)
      
      if (success) {
        global.prompt.showToast({
          message: '训练记录已保存',
        })
      }
      
      // 清除当前会话
      await clearCurrentSession()
      
      // 返回首页
      setTimeout(() => {
        global.router.clear()
        global.router.replace({
          uri: '/pages/ActionList',
        })
      }, DELAY_MS.TOAST_DISPLAY)
    },
  }
</script>

<style>
  @tailwind utilities;
</style>
