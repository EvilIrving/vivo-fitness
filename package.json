{
  "name": "fiteness",
  "version": "1.0.0",
  "packageManager": "pnpm@^9.9.0",
  "description": "Application development template using Tailwind CSS.",
  "scripts": {
    "gen": "node ./scripts/gen/index.js",
    "tailwindcss": "npx tailwindcss -i ./src/assets/styles/input.css -o ./src/assets/styles/output.css --watch",
    "lint": "eslint --ext .ux,.js src/",
    "prettier": "node ./scripts/selfCloseInputTag.js && prettier --plugin prettier-plugin-ux --write \"src/**/*.{js,ux,less,scss,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.2.0",
    "colors": "^1.4.0",
    "eslint": "^7.32.0",
    "eslint-plugin-json": "^1.4.0",
    "eslint-plugin-vue": "^9.26.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "prettier-plugin-ux": "^0.3.0"
  },
  "keywords": [
    "应用开发模版",
    "Tailwind CSS",
    "prettier"
  ],
  "dependencies": {
    "tailwindcss": "^3.4.13"
  }
}
